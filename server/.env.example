# Clave de la API de Anthropic. Obtenla en https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Puerto del servidor de orquestacion.
PORT=5178

# Sin definir por defecto: cada agente usa el modelo que le asigna roles.ts
# (opus-4-8 en arquitecto y revision, sonnet-5 en el resto - pensado para no
# agotar cuota de suscripcion). Definila solo para forzar el mismo modelo en
# las ocho fases, pisando ese reparto.
# FORGE_MODEL=claude-sonnet-5

# Rondas maximas de revision -> correccion antes de entregar igualmente.
FORGE_MAX_REVIEW_ROUNDS=2

# Techo de gasto por fase, en dolares. La fase se detiene al alcanzarlo.
FORGE_MAX_BUDGET_USD=25
